#!/usr/bin/env python3
"""Warm Edge TTS connection for firefox-edge-tts.

Two modes, selected by --serve / --client.

  --serve   Hold one websocket to Microsoft's speech endpoint open and answer
            synthesis requests on a per-user Unix socket. Firefox sends one
            utterance per paragraph; reusing the connection removes the ~1 s
            TLS + handshake cost from every paragraph after the first.

  --client  Read text on stdin, ask the server for MP3, write it on stdout.
            If the server cannot be reached or synthesis fails, fall back to a
            one-shot `edge-tts` invocation (still Edge TTS, never another
            engine).

Protocol on the Unix socket: one JSON request line, then a status line
("OK\\n" or "ERR <reason>\\n") followed by the MP3 bytes when OK.

The server imports edge-tts's internal helpers, so it is tied to the version
installed in the private venv. The client imports only the standard library,
so a broken server never prevents the one-shot fallback from running.
"""

import argparse
import json
import os
import socket
import subprocess
import sys
import time

# Reopen the upstream websocket after this much inactivity. Keeps a long-lived
# idle connection from being held open forever, and survives the service
# dropping a connection between articles.
IDLE_RECONNECT = 300

# edge-tts splits long input at word boundaries before sending SSML.
MAX_SSML_BYTES = 4096


def _client(args):
    import fcntl

    text = sys.stdin.buffer.read().decode("utf-8", "replace")
    request = json.dumps(
        {"voice": args.voice, "rate": args.rate, "text": text}
    ).encode("utf-8") + b"\n"

    def ask():
        sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        sock.settimeout(60)
        try:
            sock.connect(args.socket)
            sock.sendall(request)
            stream = sock.makefile("rb")
            status = stream.readline()
            if status != b"OK\n":
                raise RuntimeError(status.decode("utf-8", "replace").strip())
            return stream.read()
        finally:
            sock.close()

    def start_server():
        lock_path = args.socket + ".lock"
        pid_path = args.socket + ".pid"
        log_path = args.socket + ".log"
        os.makedirs(os.path.dirname(args.socket) or ".", exist_ok=True)
        with open(lock_path, "a+b") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            try:
                # Another client may have started it while we waited.
                if _probe(args.socket):
                    return
                try:
                    os.unlink(args.socket)
                except FileNotFoundError:
                    pass
                with open(log_path, "ab") as log:
                    proc = subprocess.Popen(
                        [sys.executable, os.path.abspath(__file__), "--serve",
                         "--socket", args.socket, "--pid-file", pid_path],
                        stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                        start_new_session=True,
                    )
                with open(pid_path, "w") as fh:
                    fh.write(str(proc.pid))
                for _ in range(60):
                    if _probe(args.socket):
                        return
                    if proc.poll() is not None:
                        break
                    time.sleep(0.1)
                raise RuntimeError("warm daemon did not start")
            finally:
                fcntl.flock(lock, fcntl.LOCK_UN)

    try:
        try:
            audio = ask()
        except OSError:
            start_server()
            audio = ask()
    except Exception as exc:
        print(f"edge-ttsd: warm request failed: {exc}", file=sys.stderr)
    else:
        sys.stdout.buffer.write(audio)
        return 0

    # Fallback: one-shot edge-tts. Same engine, cold connection; this is the
    # behaviour the script had before the warm daemon existed.
    proc = subprocess.run(
        [args.edge_bin, "-f", "-", "-v", args.voice,
         f"--rate={args.rate}", "--no-progress", "--write-media", "-"],
        input=text.encode("utf-8"), stdout=subprocess.PIPE,
    )
    if proc.returncode != 0:
        print("edge-ttsd: edge-tts fallback failed", file=sys.stderr)
        return 1
    sys.stdout.buffer.write(proc.stdout)
    return 0


def _probe(path):
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        sock.connect(path)
        return True
    except OSError:
        return False
    finally:
        sock.close()


def _serve(args):
    import asyncio
    import aiohttp
    from xml.sax.saxutils import escape
    from edge_tts.communicate import (
        mkssml, ssml_headers_plus_data, date_to_string, get_headers_and_data,
        connect_id, split_text_by_byte_length, remove_incompatible_characters,
    )
    from edge_tts.constants import WSS_URL, WSS_HEADERS, SEC_MS_GEC_VERSION
    from edge_tts.data_classes import TTSConfig
    from edge_tts.drm import DRM

    def speech_config():
        return (
            f"X-Timestamp:{date_to_string()}\r\n"
            "Content-Type:application/json; charset=utf-8\r\n"
            "Path:speech.config\r\n\r\n"
            '{"context":{"synthesis":{"audio":{"metadataoptions":'
            '{"sentenceBoundaryEnabled":"false","wordBoundaryEnabled":"true"},'
            '"outputFormat":"audio-24khz-48kbitrate-mono-mp3"}}}}\r\n'
        )

    class WarmConnection:
        def __init__(self):
            self.session = None
            self.ws = None
            self.lock = asyncio.Lock()
            self.last_used = 0.0

        async def close(self):
            if self.ws is not None:
                try:
                    await self.ws.close()
                except Exception:
                    pass
            if self.session is not None:
                try:
                    await self.session.close()
                except Exception:
                    pass
            self.ws = None
            self.session = None

        async def _open(self):
            await self.close()
            self.session = aiohttp.ClientSession(
                trust_env=True,
                timeout=aiohttp.ClientTimeout(
                    total=None, connect=None, sock_connect=10, sock_read=60
                ),
            )

            async def connect():
                url = (
                    f"{WSS_URL}&ConnectionId={connect_id()}"
                    f"&Sec-MS-GEC={DRM.generate_sec_ms_gec()}"
                    f"&Sec-MS-GEC-Version={SEC_MS_GEC_VERSION}"
                )
                return await self.session.ws_connect(
                    url, compress=15,
                    headers=DRM.headers_with_muid(WSS_HEADERS),
                )

            try:
                self.ws = await connect()
            except aiohttp.ClientResponseError as exc:
                if exc.status != 403:
                    raise
                DRM.handle_client_response_error(exc)
                self.ws = await connect()
            await self.ws.send_str(speech_config())

        async def synthesize(self, voice, rate, text):
            async with self.lock:
                for attempt in (0, 1):
                    try:
                        if (self.ws is None or self.ws.closed or
                                time.monotonic() - self.last_used > IDLE_RECONNECT):
                            await self._open()
                        audio = await self._speak(voice, rate, text)
                        self.last_used = time.monotonic()
                        return audio
                    except Exception:
                        await self.close()
                        if attempt == 1:
                            raise

        async def _speak(self, voice, rate, text):
            cfg = TTSConfig(
                voice=voice, rate=rate, volume="+0%", pitch="+0Hz",
                boundary="WordBoundary",
            )
            prepared = escape(remove_incompatible_characters(text))
            out = bytearray()
            for chunk in split_text_by_byte_length(prepared, MAX_SSML_BYTES):
                ssml = mkssml(cfg, chunk)
                await self.ws.send_str(
                    ssml_headers_plus_data(connect_id(), date_to_string(), ssml)
                )
                out += await self._read_turn()
            return bytes(out)

        async def _read_turn(self):
            audio = bytearray()
            async for received in self.ws:
                if received.type == aiohttp.WSMsgType.TEXT:
                    raw = received.data.encode("utf-8")
                    headers, _ = get_headers_and_data(raw, raw.find(b"\r\n\r\n"))
                    if headers.get(b"Path") == b"turn.end":
                        return bytes(audio)
                elif received.type == aiohttp.WSMsgType.BINARY:
                    raw = received.data
                    header_len = int.from_bytes(raw[:2], "big")
                    headers, data = get_headers_and_data(raw, header_len)
                    if headers.get(b"Path") == b"audio" and data:
                        audio += data
                elif received.type in (
                    aiohttp.WSMsgType.CLOSE, aiohttp.WSMsgType.CLOSED,
                    aiohttp.WSMsgType.ERROR,
                ):
                    raise RuntimeError("upstream websocket closed")
            raise RuntimeError("upstream stream ended without turn.end")

    warm = WarmConnection()

    async def handle(reader, writer):
        try:
            line = await reader.readline()
            if not line:
                return
            req = json.loads(line)
            voice, rate, text = req["voice"], req["rate"], req["text"]
            if not text.strip():
                writer.write(b"OK\n")
                await writer.drain()
                return
            audio = await warm.synthesize(voice, rate, text)
            writer.write(b"OK\n")
            writer.write(audio)
            await writer.drain()
        except Exception as exc:
            try:
                writer.write(("ERR %s\n" % exc).encode("utf-8", "replace"))
                await writer.drain()
            except Exception:
                pass
        finally:
            writer.close()
            try:
                await writer.wait_closed()
            except Exception:
                pass

    async def main():
        try:
            os.unlink(args.socket)
        except FileNotFoundError:
            pass
        os.makedirs(os.path.dirname(args.socket) or ".", exist_ok=True)
        server = await asyncio.start_unix_server(handle, path=args.socket)
        os.chmod(args.socket, 0o600)
        if args.pid_file:
            try:
                with open(args.pid_file, "w") as fh:
                    fh.write(str(os.getpid()))
            except OSError:
                pass
        warm.last_used = time.monotonic()

        async def watchdog():
            # Do not linger forever with an idle upstream connection. The next
            # utterance simply starts a fresh daemon.
            while True:
                await asyncio.sleep(30)
                if time.monotonic() - warm.last_used > 600:
                    server.close()
                    return

        watcher = asyncio.create_task(watchdog())
        try:
            async with server:
                await server.serve_forever()
        finally:
            watcher.cancel()
            await warm.close()
            for path in (args.socket, args.pid_file):
                if path:
                    try:
                        os.unlink(path)
                    except FileNotFoundError:
                        pass

    asyncio.run(main())


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--serve", action="store_true")
    parser.add_argument("--client", action="store_true")
    parser.add_argument("--socket", required=True)
    parser.add_argument("--pid-file")
    parser.add_argument("--edge-bin")
    parser.add_argument("--voice")
    parser.add_argument("--rate")
    args = parser.parse_args()

    if args.serve:
        return _serve(args)
    if args.client:
        if not args.edge_bin or not args.voice or not args.rate:
            parser.error("--client needs --edge-bin, --voice and --rate")
        return _client(args)
    parser.error("choose --serve or --client")


if __name__ == "__main__":
    sys.exit(main())
