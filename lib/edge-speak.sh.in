#!/usr/bin/env bash
# Edge TTS speech-dispatcher bridge.
#
# speech-dispatcher's sd_generic module pipes text to a synthesis command and
# plays the result. Rather than embed a fragile nested-quote pipeline in the
# module config, this thin wrapper owns the synthesis; the module config just
# feeds it text on stdin and sends raw PCM to $PLAY_COMMAND.
#
# edge-tts returns MP3 at 24 kHz mono. mpg123 decodes that to signed 16-bit
# little-endian PCM on stdout, forcing mono and 24 kHz even if the service's
# format ever changes. edge-tts diagnostics stay on stderr so they never
# corrupt the audio stream.

set -uo pipefail

VOICE=""
RATE="0"
PAUSE=""

usage() {
    cat >&2 <<'USAGE'
usage: edge-speak --voice <short-name> [--rate <-100..100>] [--pause <ms>|natural]
Reads text on stdin, writes raw s16le 24 kHz mono audio to stdout.

  --pause <ms>   leave exactly <ms> of silence after the last audible sample
                 (0 trims it entirely, 10000 is the maximum)
  --pause natural
                 pass the service's own trailing silence through (default)
USAGE
}

while [ $# -gt 0 ]; do
    case "$1" in
        --voice) VOICE="${2:-}"; shift 2 ;;
        --rate)  RATE="${2:-0}"; shift 2 ;;
        --pause)
            [ $# -ge 2 ] || { printf 'edge-speak: --pause needs a value\n' >&2; exit 2; }
            PAUSE="$2"; shift 2 ;;
        --help|-h) usage; exit 0 ;;
        *) printf 'edge-speak: unknown argument: %s\n' "$1" >&2; exit 2 ;;
    esac
done

[ -n "$VOICE" ] || { printf 'edge-speak: --voice is required\n' >&2; exit 2; }

# speech-dispatcher sends -100..100. edge-tts wants [+-]N%, including an
# explicit sign for zero. Clamp so the output stays intelligible.
#
# sd_generic normally passes an integer, but depending on GenericRateForceInteger
# and the rate multiplier it can pass a decimal ("50.00"). Accept both instead of
# treating the decimal as unparseable and silently resetting to normal speed.
if ! [[ "$RATE" =~ ^[-+]?[0-9]+([.][0-9]+)?$ ]]; then
    RATE=0
fi
RATE=${RATE%%.*}
RATE=${RATE#+}
[ "$RATE" -lt -100 ] && RATE=-100
[ "$RATE" -gt 100 ] && RATE=100
if [ "$RATE" -lt 0 ]; then
    rate_arg="-${RATE#-}%"
else
    rate_arg="+${RATE}%"
fi

# --pause sets the silence left after the last audible sample. "natural" (the
# default) leaves the service's audio untouched. A number trims or pads the tail
# to that many milliseconds. This controls the silence after the voice, not the
# total gap between paragraphs: the next paragraph still pays edge-tts startup.
if [ -n "$PAUSE" ] && [ "$PAUSE" != "natural" ]; then
    if ! [[ "$PAUSE" =~ ^[0-9]+$ ]] || [ "$PAUSE" -gt 10000 ]; then
        printf 'edge-speak: --pause must be milliseconds (0-10000) or "natural"\n' >&2
        exit 2
    fi
fi

text=$(cat) || exit 1
# An empty utterance is not an error; just produce no audio.
[ -n "${text//[[:space:]]/}" ] || exit 0

# Ask the warm daemon for MP3. The client starts the daemon on first use and
# falls back to a one-shot edge-tts invocation if it cannot be reached, so a
# broken daemon can never leave Firefox silent.
synthesize() {
    printf '%s' "$text" \
        | "__PYTHON__" "__DAEMON__" --client \
            --socket "__SOCKET__" --edge-bin "__EDGE_BIN__" \
            --voice "$VOICE" --rate="$rate_arg" \
        | "__MPG123__" -q -m -r 24000 -s -
}

# Rewrite the final run of silence to exactly $1 milliseconds. A sample counts
# as silence when it is within +/-32 (about -60 dBFS). Quiet runs are held until
# the next audible sample, so pauses inside a paragraph pass through unchanged;
# only the trailing run is trimmed or padded. Streaming is preserved: at most
# the current quiet run is buffered.
trim_trailing_silence() {
    local script
    script=$(cat <<'PY'
import sys
from array import array

target_ms = int(sys.argv[1])
rate = 24000
target_bytes = (target_ms * rate // 1000) * 2
threshold = 32
pending = bytearray()
out = sys.stdout.buffer

while True:
    chunk = sys.stdin.buffer.read(65536)
    if not chunk:
        break
    if len(chunk) % 2:
        chunk += sys.stdin.buffer.read(1)
    samples = array('h')
    samples.frombytes(chunk)
    if sys.byteorder == 'big':
        samples.byteswap()
    for value in samples:
        if -threshold <= value <= threshold:
            pending += value.to_bytes(2, 'little', signed=True)
        else:
            if pending:
                out.write(pending)
                pending = bytearray()
            out.write(value.to_bytes(2, 'little', signed=True))

# Keep the start of the natural decay when trimming, and pad with digital
# silence when the service left less than the requested pause.
if len(pending) >= target_bytes:
    out.write(pending[:target_bytes])
else:
    out.write(pending)
    out.write(b'\x00\x00' * ((target_bytes - len(pending)) // 2))
PY
)
    "__PYTHON__" -c "$script" "$1"
}

if [ -n "$PAUSE" ] && [ "$PAUSE" != "natural" ]; then
    synthesize | trim_trailing_silence "$PAUSE"
else
    synthesize
fi
